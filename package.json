{
  "name": "expo-notifications-api",
  "version": "1.0.0",
  "description": "Demo backend for Expo push notifications and deep-link testing",
  "main": "dist/api/server.js",
  "scripts": {
    "dev": "dotenvx run --env-file=.env.development -- nodemon api/server.ts",
    "build": "tsc",
    "start": "node dist/api/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "dotenvx run --env-file=.env.development -- prisma migrate deploy",
    "prisma:migrate:create": "dotenvx run --env-file=.env.development -- prisma migrate dev",
    "prisma:seed": "dotenvx run --env-file=.env.development -- prisma db seed"
  },
  "author": "Sabrina Demetrio",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SabriBere/expo-notifications-api.git"
  },
  "bugs": {
    "url": "https://github.com/SabriBere/expo-notifications-api/issues"
  },
  "homepage": "https://github.com/SabriBere/expo-notifications-api#readme",
  "keywords": [
    "expo",
    "push-notifications",
    "prisma",
    "typescript"
  ],
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^20.14.9",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.4.0",
    "nodemon": "^3.1.4",
    "prettier": "^3.8.1",
    "prisma": "^5.11.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2"
  },
  "dependencies": {
    "@dotenvx/dotenvx": "^1.1.0",
    "@prisma/client": "^5.11.0",
    "cors": "^2.8.5",
    "expo-server-sdk": "^6.1.0",
    "express": "^4.19.2",
    "morgan": "^1.10.0"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
