generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Alert {
  id          Int    @id @default(autoincrement())
  Title       String
  Tier        Int
  Tone        Int
  MediaType   Int
  Media       String
  Section     String
  Link        String
  ConsultasId Int    @unique
  NoticiaId   Int    @unique
}
