generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

model Users {
  id       Int    @id @default(autoincrement())
  email    String @unique
  userName String
  password String
}

model Alerts {
  id         Int     @id @default(autoincrement())
  idSignal   Int     @unique
  signalName String?
  text       String
  date       String
  hour       String
}
